# Leave blank to detect the Expo/Metro host automatically in development.
# Set this for a standalone APK, e.g. https://your-host.example
EXPO_PUBLIC_API_URL=

# Email SMTP settings (for password reset emails sent to user Gmail / inbox)
# On Render: Add these under Environment Variables
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
